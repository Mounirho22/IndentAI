# IdentAI environment configuration.
# Copy to .env and fill in your values. NEVER commit the real .env.

# --- Primary model provider -------------------------------------------------
# bedrock  = Amazon Bedrock (default; needs AWS credentials)
# litellm  = Gemini via LiteLLM (needs GEMINI_API_KEY)
# mock     = fully offline deterministic mode (no model calls at all)
MODEL_PROVIDER=bedrock

# --- Amazon Bedrock ----------------------------------------------------------
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS credentials resolve through the standard chain: environment variables,
# ~/.aws/credentials, `aws sso login`, or an IAM role. Set these only if you
# prefer explicit values:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Optional fallback provider (MODEL_PROVIDER=litellm) ---------------------
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL_ID=gemini/gemini-2.0-flash

# --- Application settings -----------------------------------------------------
PORT=8000
LESSONS_DB_PATH=data/lessons.db
# Per-mission agent budgets (development defaults are uncapped)
STRANDS_AGENT_MAX_TURNS=40
# CURRICULUM_TIER_TIMEOUT_SECONDS=120
